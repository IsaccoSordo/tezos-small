{
  "name": "tezos-small",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run set-env && ng serve",
    "build": "npm run set-env && ng build",
    "build:prod": "npm run set-env && ng build --configuration production --base-href=/tezos-small/",
    "watch": "npm run set-env && ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && ngc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "set-env": "npx ts-node --project scripts/tsconfig.json scripts/set-env.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@ngneat/cashew": "5.3.0",
    "@ngrx/operators": "22.0.1",
    "@ngrx/signals": "22.0.1",
    "@primeuix/themes": "3.0.0",
    "primeicons": "8.0.1",
    "primeng": "22.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@angular/localize": "22.1.6",
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.4",
    "angular-eslint": "22.5.0",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
