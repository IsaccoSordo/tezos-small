# Firebase Configuration
# Copy this file to .env and fill in your values
# These values are used by scripts/set-env.ts to generate environment files

FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_SENDER_ID=your_firebase_sender_id_here
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# PrimeNG license (community tier). Required since primeng@22.1.1 to suppress
# the "Invalid PrimeUI License" banner every PrimeNG component now renders.
PRIMENG_UI_KEY=your_primeng_license_key_here
